<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fly The Plane Daily</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #ffffff;
      --fg: #1a1a1a;
      --muted: #6b6b6b;
      --border: #e5e5e5;
      --accent: #0b5fff;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #14161a;
        --fg: #e8e8e8;
        --muted: #9a9a9a;
        --border: #2a2d33;
        --accent: #6fa8ff;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 2rem 1rem 4rem;
      background: var(--bg);
      color: var(--fg);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.5;
    }
    main {
      max-width: 720px;
      margin: 0 auto;
    }
    header {
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1rem;
    }
    h1 {
      font-size: 1.5rem;
      margin: 0 0 0.25rem;
    }
    .subtitle {
      color: var(--muted);
      font-size: 0.9rem;
    }
    article.item {
      padding: 1.1rem 0;
      border-bottom: 1px solid var(--border);
    }
    article.item:last-child {
      border-bottom: none;
    }
    .headline {
      font-size: 1.05rem;
      font-weight: 600;
      margin: 0 0 0.4rem;
    }
    .headline a {
      color: var(--fg);
      text-decoration: none;
    }
    .headline a:hover {
      color: var(--accent);
      text-decoration: underline;
    }
    .summary {
      margin: 0 0 0.5rem;
    }
    .meta {
      font-size: 0.82rem;
      color: var(--muted);
    }
    .meta a {
      color: var(--muted);
    }
    footer {
      margin-top: 2.5rem;
      font-size: 0.8rem;
      color: var(--muted);
      text-align: center;
    }
    .empty {
      color: var(--muted);
    }
  </style>
</head>
<body>
  <main>
    <header>
      <h1>Fly The Plane Daily</h1>
      <div class="subtitle">{{ item_count }} stories from the last 24 hours &middot; built {{ generated_at }}</div>
    </header>

    {% if items %}
      {% for item in items %}
      <article class="item">
        <p class="headline"><a href="{{ item.link }}" target="_blank" rel="noopener">{{ item.title }}</a></p>
        <p class="summary">{{ item.summary }}</p>
        <p class="meta">{{ item.source }} &middot; {{ item.published }}</p>
      </article>
      {% endfor %}
    {% else %}
      <p class="empty">No stories in the last 24 hours.</p>
    {% endif %}

    <footer>Generated automatically from {{ source_count }} sources.</footer>
  </main>
</body>
</html>
